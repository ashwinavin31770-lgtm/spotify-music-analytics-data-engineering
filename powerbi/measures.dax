Total Tracks = COUNTROWS(GOLD_TOP_TRACKS)

Average Popularity = AVERAGE(GOLD_TOP_TRACKS[POPULARITY])

Average Energy = AVERAGE(GOLD_TOP_TRACKS[ENERGY])

Average Danceability = AVERAGE(GOLD_TOP_TRACKS[DANCEABILITY])

Average Tempo = AVERAGE(GOLD_TOP_TRACKS[TEMPO])

Total Genres = DISTINCTCOUNT(GOLD_TOP_TRACKS[GENRE])
